<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RipgrepSearch</AssemblyName>
    <Version>0.10.0</Version>
    <RootNamespace>RipgrepSearch</RootNamespace>
    <ApplicationIcon>RipgrepSearch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="src\RipgrepSearch.Core\RipgrepSearch.Core.csproj" />
    <InternalsVisibleTo Include="RipgrepSearch.Tests" />
  </ItemGroup>
</Project>
